# ============================================================================
#  PR Streams — configuration
#  Copy this file to  config.env  and fill in your values.
#  (On PaaS like Koyeb/Render/Heroku, set these as environment variables.)
# ============================================================================

# ---- Required: Telegram credentials ----------------------------------------
# Get API_ID and API_HASH from https://my.telegram.org  (API development tools)
API_ID=12345678
API_HASH=your_api_hash_here
# Get a bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Private channel where every uploaded file is stored. Create a private channel,
# add the bot (and any MULTI_TOKEN bots) as ADMIN, then put its id here.
# The id starts with -100  (use @userinfobot / forward a post to it to find it).
STORAGE_CHANNEL=-1001234567890

# ---- Required: public address ----------------------------------------------
# The public hostname or IP where this server is reachable (NO http:// , NO trailing /)
FQDN=your.domain.com
# Set HAS_SSL=true if the public URL is https (e.g. behind nginx/Caddy on 443).
HAS_SSL=true
# Set NO_PORT=true when a reverse proxy serves it on the default 80/443 port,
# so links don't include :8080.
NO_PORT=true

# ---- Web server -------------------------------------------------------------
BIND_ADDRESS=0.0.0.0
PORT=8080

# ---- Access control (optional) ---------------------------------------------
# Space/comma separated Telegram user ids that own the bot (see /status etc.)
OWNER_ID=
# If set, ONLY these user ids (plus OWNER_ID) may create links. Empty = everyone.
ALLOWED_USERS=

# ---- Speed: multi-client load balancing (optional but recommended) ---------
# Add extra bot tokens to spread downloads across several connections.
# Each of these bots MUST also be an admin of STORAGE_CHANNEL.
# MULTI_TOKEN1=...
# MULTI_TOKEN2=...
# Optionally add user session strings (generate with:  python generate_session.py)
# A Telegram Premium account here also enables serving up to 4 GB files.
# USER_SESSION1=...

# ---- Tuning (optional) ------------------------------------------------------
WORKERS=8
SLEEP_THRESHOLD=60
HASH_LENGTH=6
# Self-ping seconds to keep sleepy PaaS awake. Keep 0 on a VPS.
PING_INTERVAL=0
NAME=PR Streams
